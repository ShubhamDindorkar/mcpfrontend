
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")   
}

model Package {
  package_name String   @id @db.Text
  install_cmd  String   @db.Text
  readme       String   @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@map("packages")
}